# quant-lab: daily database snapshot (keeps three)
[Unit]
Description=quant-lab daily database snapshot (keeps three)
After=qlab-api.service
Wants=qlab-api.service
OnFailure=qlab-failed@%n.service

[Service]
Type=oneshot
User=qlab
WorkingDirectory=/srv/quant-lab
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/quant-lab/.venv/bin/qlab backup --keep 3
TimeoutStartSec=30min
