# quant-lab: heartbeat: check the lab and ping the outside dead-man's switch
[Unit]
Description=quant-lab heartbeat: check the lab and ping the outside dead-man's switch
After=qlab-api.service
Wants=qlab-api.service


[Service]
Type=oneshot
User=qlab
WorkingDirectory=/srv/quant-lab
Environment=PYTHONUNBUFFERED=1
ExecStart=-/srv/quant-lab/.venv/bin/qlab heartbeat
TimeoutStartSec=2min
