# quant-lab: weekly research inbox: arXiv papers scored by the language model, the digest
[Unit]
Description=quant-lab weekly research inbox: arXiv papers scored by the language model, the digest
After=qlab-api.service
Wants=qlab-api.service
OnFailure=qlab-failed@%n.service

[Service]
Type=oneshot
User=qlab
WorkingDirectory=/srv/quant-lab
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/qlab/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/quant-lab/.venv/bin/qlab inbox run
TimeoutStartSec=3h
