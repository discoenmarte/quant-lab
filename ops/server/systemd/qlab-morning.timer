# quant-lab: when to run qlab-morning.service. Times are in the exchange's or the owner's timezone, not the server's.
[Unit]
Description=quant-lab morning broker step schedule

[Timer]
OnCalendar=Mon..Fri 09:50 America/New_York
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
