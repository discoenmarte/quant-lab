# quant-lab: the radar's deep daily pass: history from every source (Wikipedia, GDELT, markets), then a scan
[Unit]
Description=quant-lab radar deep pass: every source with history, then a scan (weekly recalibration included)
After=qlab-api.service
Wants=qlab-api.service
OnFailure=qlab-failed@%n.service

[Service]
Type=oneshot
User=qlab
WorkingDirectory=/srv/quant-lab
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/quant-lab/.venv/bin/qlab radar run --deep
TimeoutStartSec=2h
